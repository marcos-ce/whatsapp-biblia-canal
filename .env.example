# ==========================================
# WhatsApp Bíblia Canal - Configurações
# ==========================================

# Identificador do Canal do WhatsApp (JID)
# Formato do canal de atualizações: 120363xxxxxxxxxxxx@newsletter
# Ou se for um grupo fechado: 120363xxxxxxxxxxxx@g.us
CHANNEL_JID=120363xxxxxxxxxxxx@newsletter

# Nome ou assinatura do seu canal (aparece no rodapé da mensagem)
CHANNEL_NAME="Palavra Diária"

# Link público de convite do canal (opcional, para incentivar compartilhamento)
CHANNEL_INVITE_LINK=https://whatsapp.com/channel/seu-link-aqui

# ☀️ Horário da Mensagem de Bom Dia (Manhã) - Horário de Brasília
MORNING_HOUR=6
MORNING_MINUTE=0

# 🌙 Horário da Mensagem de Boa Noite (Noite) - Horário de Brasília
EVENING_HOUR=18
EVENING_MINUTE=0

# Versão padrão da Bíblia ("NVI" ou "ACF")
BIBLE_VERSION="NVI"
