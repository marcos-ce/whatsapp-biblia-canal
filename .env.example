# ==========================================
# WhatsApp Bíblia Canal - Configurações
# ==========================================

# Identificador do Canal do WhatsApp
# Pode ser o LINK completo ou o JID (@newsletter):
CHANNEL_JID=https://whatsapp.com/channel/0029VbDYU2MAInPrO6krdG0g

# Nome ou assinatura do seu canal (aparece no rodapé da mensagem)
CHANNEL_NAME="Bíblia Sagrada - Versículos E Devocional"

# Link público de convite do canal (para seguidores compartilharem)
CHANNEL_INVITE_LINK=https://whatsapp.com/channel/0029VbDYU2MAInPrO6krdG0g

# Seu número de WhatsApp para poder enviar comandos (/postar, /bomdia, /boanoite)
# Formato: 5585999999999 (com DDI e DDD, sem espaços)
# Nota: Você também pode mandar mensagem no chat consigo mesmo ("Você") no próprio WhatsApp conectado!
ADMIN_PHONE=

# ☀️ Horário da Mensagem de Bom Dia (Manhã) - Horário de Brasília
MORNING_HOUR=6
MORNING_MINUTE=0

# 🌙 Horário da Mensagem de Boa Noite (Noite) - Horário de Brasília
EVENING_HOUR=18
EVENING_MINUTE=0

# Versão padrão da Bíblia ("NVI" ou "ACF")
BIBLE_VERSION="NVI"
